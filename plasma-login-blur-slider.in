#!/bin/bash
# SPDX-FileCopyrightText: 2026 plasma-login-blur-slider contributors
# SPDX-License-Identifier: GPL-3.0-or-later
#
# plasma-login-blur-slider: a blur-intensity setting for the Plasma Login
# Manager login screen, without patching or rebuilding Plasma Login Manager.
#
# How it works
# ------------
# Plasma Login Manager shows its wallpaper with an ordinary Plasma wallpaper
# plugin (a directory of QML under /usr/share/plasma/wallpapers/<id>), and the
# "Login Screen" settings page embeds that plugin's own configuration page.
# Plugins are looked up along XDG_DATA_DIRS, where /usr/local/share comes
# before /usr/share.
#
# "sync" therefore creates a small overlay plugin with the same id in
# /usr/local/share/plasma/wallpapers/<id>. The overlay contains no copy of the
# stock QML: its main.qml and config.qml *inherit* from the stock files
# (through stock/qmldir) and only add
#   * the settings LoginBlurIntensity and LoginBlurStyle (merged into a copy
#     of the plugin's schema),
#   * controls for them that show up in the Login Screen settings only, and
#   * a hook that scales the blur of the login screen and of the lock screen
#     by the intensity and, for the "frosted" style, lays a Gaussian blur
#     over it. Each of the two screens has its own settings.
# Deleting the overlay ("remove") brings the stock plugin back untouched.

set -euo pipefail
umask 022

readonly PROG=plasma-login-blur-slider
readonly VERSION=@VERSION@
readonly MARKER=.plasma-login-blur-slider
readonly KEY=LoginBlurIntensity
readonly STYLE_KEY=LoginBlurStyle

DATADIR=${PLASMA_LOGIN_BLUR_SLIDER_DATADIR:-@DATADIR@}
CONFFILE=${PLASMA_LOGIN_BLUR_SLIDER_CONF:-/etc/plasma-login-blur-slider.conf}

# --- defaults; override any of these in /etc/plasma-login-blur-slider.conf ---

# Wallpaper plugins to overlay: those Plasma Login Manager offers as
# "Wallpaper type", and Slideshow, which the lock screen offers as well. Ids
# that are not installed are skipped. Use "all" to overlay every plugin found
# in STOCK_ROOT (for other wallpaper types you use on the lock screen).
PLUGINS="org.kde.image org.kde.slideshow org.kde.color org.kde.potd org.kde.haenau org.kde.hunyango org.kde.tiled online.knowmad.shaderwallpaper"
# Where the distribution installs wallpaper plugins.
STOCK_ROOT=/usr/share/plasma/wallpapers
# Where the overlays go. Its "…/share" directory must come before the one of
# STOCK_ROOT in XDG_DATA_DIRS (true for /usr/local/share on common setups).
OVERLAY_ROOT=/usr/local/share/plasma/wallpapers
# Plasma Login Manager's configuration file (used by "get" and "set").
LOGIN_CONFIG=/etc/plasmalogin.conf
# The user the login screen runs as.
LOGIN_USER=plasmalogin
# The login screen has its own compositor (KWin) with its own settings.
# Third-party "blur every window" effects such as Better Blur DX, when enabled
# there, blur the whole login wallpaper permanently, whatever the blur
# intensity is set to. "off" switches such effects off for the login screen
# (never for your desktop); "keep" leaves the login screen's compositor alone.
LOGIN_COMPOSITOR_BLUR=off
# More compositor effects to switch off for the login screen, by id, separated
# by spaces. Every effect with "blur" in its id is covered already, except
# KWin's own "blur", which only blurs where a window asks for it.
LOGIN_COMPOSITOR_EFFECTS=""

QUIET=0
# --lock: get/set/style act on the lock screen of the current user instead of
# on the login screen.
LOCK=0

msg()  { [ "$QUIET" = 1 ] || printf '%s\n' "$*"; }
warn() { printf '%s: %s\n' "$PROG" "$*" >&2; }
die()  { warn "$*"; exit 1; }

usage() {
    cat <<EOF
Usage: $PROG <command> [options]

Commands:
  sync            Create or refresh the wallpaper overlays (run as root).
                  Safe to run at any time; run it after Plasma updates.
  remove          Delete all overlays, restoring the stock plugins (as root).
  status          Show what is installed and the current blur settings.
  get             Print the blur intensity (0-100) of the login wallpaper.
  set <0-100>     Set the blur intensity of the login wallpaper (as root).
                  Same as moving the slider in System Settings > Login Screen
                  > Configure Appearance.
  style           Print the blur style of the login wallpaper.
  style standard|frosted
                  Set it (as root). "standard" is the login screen's own
                  blur; "frosted" is a smooth frosted-glass blur like a
                  compositor's, much stronger at the same intensity (about
                  25% frosted is as strong as 100% standard). Same as "Blur
                  style" in the Login Screen settings.
  get|set|style ... --lock
                  The same for your lock screen, which has its own settings
                  (System Settings > Screen Locking > Configure Appearance).
                  They are yours alone: run these without sudo.
  login-compositor
                  Switch off third-party blur effects for the login screen's
                  compositor (see LOGIN_COMPOSITOR_BLUR). "sync" does this,
                  and so does every start of the login screen; there is
                  normally no need to run it by hand.
  debug on|off    Switch diagnostics on or off (as root). While on, the login
                  wallpaper process logs what it is doing and saves
                  screenshots of its own output to /tmp at every start.
  report          Collect everything needed to diagnose a problem into a
                  folder in your home directory (as root).

Options:
  --lock          With get, set and style: the lock screen instead of the
                  login screen.
  -q, --quiet     Only print warnings and errors.
  -h, --help      Show this help.
  -V, --version   Show the version.

Settings can be overridden in $CONFFILE
(PLUGINS, STOCK_ROOT, OVERLAY_ROOT, LOGIN_CONFIG, LOGIN_USER,
LOGIN_COMPOSITOR_BLUR, LOGIN_COMPOSITOR_EFFECTS).
EOF
}

load_conf() {
    if [ -r "$CONFFILE" ]; then
        # shellcheck disable=SC1090
        . "$CONFFILE"
    fi
    STOCK_ROOT=${STOCK_ROOT%/}
    OVERLAY_ROOT=${OVERLAY_ROOT%/}
    case "$LOGIN_COMPOSITOR_BLUR" in
        off|keep) ;;
        *) die "LOGIN_COMPOSITOR_BLUR must be \"off\" or \"keep\" (check $CONFFILE)" ;;
    esac

    local dir
    for dir in "$STOCK_ROOT" "$OVERLAY_ROOT"; do
        case "$dir" in
            /?*) ;;
            *) die "STOCK_ROOT and OVERLAY_ROOT must be absolute paths below / (check $CONFFILE)" ;;
        esac
    done
}

need_root() {
    [ "$(id -u)" = 0 ] || die "this command must be run as root"
}

is_ours() {
    [ -f "$1/$MARKER" ]
}

# Is at least one of our overlays in place?
any_overlay() {
    local d
    for d in "$OVERLAY_ROOT"/*/; do
        is_ours "${d%/}" && return 0
    done
    return 1
}

# The plugin ids to overlay, one per line.
selected_plugins() {
    if [ "$PLUGINS" = all ]; then
        local d
        for d in "$STOCK_ROOT"/*/; do
            [ -d "$d" ] && basename "$d"
        done
    else
        # shellcheck disable=SC2086
        printf '%s\n' $PLUGINS
    fi
}

# in_list <needle> <item>...
in_list() {
    local needle=$1 item
    shift
    for item in "$@"; do
        [ "$item" = "$needle" ] && return 0
    done
    return 1
}

remove_overlay() {
    local target=$1
    is_ours "$target" || return 0
    rm -rf -- "$target"
}

# Write the plugin's settings schema plus our entry to $2. $1 is the stock
# schema (which may not exist).
write_schema() {
    local stock=$1 out=$2
    local group
    group=$(cat <<EOF
  <group name="General">
    <entry name="$KEY" type="Int">
      <label>Blur intensity of the wallpaper on the Plasma login screen, in percent (added by $PROG)</label>
      <default>100</default>
      <min>0</min>
      <max>100</max>
    </entry>
    <entry name="$STYLE_KEY" type="String">
      <label>Kind of blur on the Plasma login screen: "standard" (the login screen's own) or "frosted" (frosted glass) (added by $PROG)</label>
      <default>standard</default>
    </entry>
    <entry name="LoginBlurDebug" type="Bool">
      <label>Write diagnostics about the login wallpaper to the journal and /tmp (added by $PROG)</label>
      <default>false</default>
    </entry>
  </group>
EOF
)
    if [ ! -f "$stock" ]; then
        {
            printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>'
            printf '%s\n' '<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0">'
            printf '%s\n' '  <kcfgfile name=""/>'
            printf '%s\n' "$group"
            printf '%s\n' '</kcfg>'
        } > "$out"
        return 0
    fi

    if grep -q "name=\"$KEY\"" "$stock"; then
        cp -- "$stock" "$out"
        return 0
    fi

    # Insert our group right before the last "</kcfg>".
    GROUP=$group awk '
        { buf = buf $0 "\n" }
        END {
            pos = 0
            while ((p = index(substr(buf, pos + 1), "</kcfg>")) > 0) {
                pos += p
            }
            if (pos == 0) {
                exit 1
            }
            printf "%s%s\n%s", substr(buf, 1, pos - 1), ENVIRON["GROUP"], substr(buf, pos)
        }
    ' "$stock" > "$out" || return 1

    grep -q "name=\"$KEY\"" "$out"
}

# Create or refresh the overlay for one plugin id.
build_overlay() {
    local id=$1
    local stock=$STOCK_ROOT/$id
    local target=$OVERLAY_ROOT/$id

    if [ ! -f "$stock/metadata.json" ] || [ ! -f "$stock/contents/ui/main.qml" ]; then
        # Not installed (or not a plain QML wallpaper plugin): nothing to
        # overlay, and an overlay left over from before would be broken.
        if is_ours "$target"; then
            remove_overlay "$target"
            msg "  $id: stock plugin is gone, overlay removed"
        fi
        return 0
    fi

    if [ -e "$target" ] && ! is_ours "$target"; then
        warn "$target exists and was not created by $PROG; leaving it alone"
        return 0
    fi

    local stock_ui overlay_root_real
    stock_ui=$(readlink -f -- "$stock/contents/ui")
    overlay_root_real=$(readlink -f -- "$OVERLAY_ROOT")

    case "$stock_ui$overlay_root_real$id" in
        *[[:space:]]*)
            warn "$id: paths containing whitespace are not supported; skipped"
            return 0
            ;;
    esac
    case "$stock_ui/" in
        "$overlay_root_real"/*)
            warn "$id: STOCK_ROOT and OVERLAY_ROOT resolve to the same place; skipped"
            return 0
            ;;
    esac

    local tmp=$OVERLAY_ROOT/.$id.$PROG.$$
    rm -rf -- "$tmp"
    mkdir -p -- "$tmp/contents/config" "$tmp/contents/ui/stock" "$tmp/contents/ui/plmblur"

    {
        printf '# Created by %s %s.\n' "$PROG" "$VERSION"
        printf '# This directory overlays the wallpaper plugin below. Delete it (or run\n'
        printf '# "%s remove") to get the stock plugin back.\n' "$PROG"
        printf 'source=%s\n' "$stock"
    } > "$tmp/$MARKER"

    # The plugin keeps its id, name and translations.
    cp -- "$stock/metadata.json" "$tmp/metadata.json"

    # Settings schema: the stock one plus LoginBlurIntensity.
    if ! write_schema "$stock/contents/config/main.xml" "$tmp/contents/config/main.xml"; then
        warn "$id: could not extend the settings schema; skipped"
        rm -rf -- "$tmp"
        return 0
    fi

    # stock/qmldir gives the stock main.qml/config.qml a type name our wrappers
    # can inherit from. qmldir wants paths relative to its own directory, and
    # KPackage hands out canonical paths, so climb up from the canonical
    # location of <overlay>/contents/ui/stock to "/".
    local qmldir_dir=$overlay_root_real/$id/contents/ui/stock
    local up="" rest=${qmldir_dir#/}
    while [ -n "$rest" ]; do
        up="../$up"
        case "$rest" in
            */*) rest=${rest#*/} ;;
            *) rest="" ;;
        esac
    done
    local rel=${up%/}$stock_ui

    {
        printf '# Generated by %s; points at the stock plugin in %s\n' "$PROG" "$stock"
        printf 'StockMain 1.0 %s/main.qml\n' "$rel"
        if [ -f "$stock/contents/ui/config.qml" ]; then
            printf 'StockConfig 1.0 %s/config.qml\n' "$rel"
        fi
    } > "$tmp/contents/ui/stock/qmldir"

    cp -- "$DATADIR/wrappers/main.qml" "$tmp/contents/ui/main.qml"
    if [ -f "$stock/contents/ui/config.qml" ]; then
        cp -- "$DATADIR/wrappers/config.qml" "$tmp/contents/ui/config.qml"
    else
        cp -- "$DATADIR/wrappers/config-standalone.qml" "$tmp/contents/ui/config.qml"
    fi
    cp -- "$DATADIR"/qml/*.qml "$tmp/contents/ui/plmblur/"

    # While the old overlay is gone and the new one is not yet in place, the
    # stock plugin is found instead, so there is never a broken state.
    remove_overlay "$target"
    if ! mv -T -- "$tmp" "$target" 2>/dev/null; then
        rm -rf -- "$tmp"
        warn "$id: could not put the overlay in place; skipped"
        return 0
    fi
    msg "  $id: overlay ready"
}

# --- the login screen's compositor -------------------------------------------
#
# The login screen runs its own KWin, as its own user, with that user's
# kwinrc. A third-party "blur every window" effect (Better Blur and its forks)
# that is enabled there blurs everything behind the login screen's window,
# that is the whole wallpaper, all the time, and nothing in the login screen's
# own settings has a say over it. Such effects typically end up enabled there
# because desktop settings were copied to the login user at some point.
#
# compositor_fix switches them off in the login user's kwinrc, and nowhere
# else, and notes there what it switched off; compositor_restore undoes
# exactly that.

login_home() {
    getent passwd "$LOGIN_USER" 2>/dev/null | cut -d: -f6
}

# Run a command as the login screen's user, so that its files stay its own.
# With a time limit: this runs during package updates and before the login
# screen starts, where nothing may ever get stuck.
as_login_user() {
    if [ "$(id -un)" = "$LOGIN_USER" ]; then
        timeout 10 "$@"
    else
        timeout 10 runuser -u "$LOGIN_USER" -- env -i HOME="$(login_home)" PATH=/usr/local/bin:/usr/bin:/bin "$@"
    fi
}

# Print "<effect id> <value>" for each "<id>Enabled" entry in the [Plugins]
# group of a KWin configuration file.
plugin_states() {
    [ -r "$1" ] || return 0
    awk '
        /^\[/ { inside = ($0 == "[Plugins]"); next }
        inside {
            eq = index($0, "=")
            if (eq == 0) next
            key = substr($0, 1, eq - 1)
            value = tolower(substr($0, eq + 1))
            gsub(/\[[^]]*\]/, "", key)
            gsub(/[ \t\r]/, "", value)
            if (key ~ /Enabled$/) {
                sub(/Enabled$/, "", key)
                if (key ~ /^[A-Za-z0-9_.-]+$/) print key, value
            }
        }' "$1"
}

# The effects the login screen's compositor would load ("<id> <value>" lines,
# the most specific file last so that it wins).
login_plugin_states() {
    local home=$1 f
    for f in /etc/xdg/kwinrc "$home/.config/kdedefaults/kwinrc" "$home/.config/kwinrc"; do
        plugin_states "$f"
    done
}

# Is this an effect that blurs the login wallpaper on its own account?
is_unwanted_effect() {
    local id=$1 extra
    case "${id,,}" in
        blur) return 1 ;;   # KWin's own effect: only blurs where a window asks for it
        *blur*) return 0 ;;
    esac
    for extra in $LOGIN_COMPOSITOR_EFFECTS; do
        [ "$id" = "$extra" ] && return 0
    done
    return 1
}

# The unwanted effects that are enabled for the login screen, one per line.
unwanted_enabled_effects() {
    local home=$1 id value
    local -A state=()
    while read -r id value; do
        state[$id]=$value
    done < <(login_plugin_states "$home")
    for id in "${!state[@]}"; do
        [ "${state[$id]}" = true ] || continue
        if is_unwanted_effect "$id"; then
            printf '%s\n' "$id"
        fi
    done | sort
}

# The effects compositor_fix has switched off, one per line.
compositor_marker() {
    [ -r "$1" ] || return 0
    awk -v group="[$PROG]" '
        /^\[/ { inside = ($0 == group); next }
        inside && /^DisabledEffects=/ {
            sub(/^[^=]*=/, "")
            n = split($0, ids, ",")
            for (i = 1; i <= n; i++) if (ids[i] ~ /^[A-Za-z0-9_.-]+$/) print ids[i]
        }' "$1"
}

compositor_fix() {
    [ "$LOGIN_COMPOSITOR_BLUR" = off ] || return 0
    command -v kwriteconfig6 >/dev/null || return 0
    # Only while the add-on is in use: "remove" must bring everything back.
    any_overlay || return 0

    local home
    home=$(login_home)
    [ -n "$home" ] || return 0

    local enabled
    enabled=$(unwanted_enabled_effects "$home")
    [ -n "$enabled" ] || return 0

    local cfg=$home/.config/kwinrc id switched=()
    [ -d "$home/.config" ] || as_login_user mkdir -p -- "$home/.config" 2>/dev/null || true
    for id in $enabled; do
        if as_login_user kwriteconfig6 --file "$cfg" --group Plugins --key "${id}Enabled" false 2>/dev/null; then
            switched+=("$id")
        else
            warn "could not switch off the compositor effect \"$id\" for the login screen"
        fi
    done
    [ ${#switched[@]} -gt 0 ] || return 0

    # Remember what was switched off so that "remove" can switch it back on.
    local all
    all=$({ compositor_marker "$cfg"; printf '%s\n' "${switched[@]}"; } | sort -u | paste -sd, -)
    as_login_user kwriteconfig6 --file "$cfg" --group "$PROG" --key DisabledEffects "$all" 2>/dev/null || true

    # Worth a line even with --quiet: this changes what the login screen looks like.
    printf '%s: switched off for the login screen (your desktop is not affected): %s\n' "$PROG" "${switched[*]}"
}

compositor_restore() {
    command -v kwriteconfig6 >/dev/null || return 0
    local home
    home=$(login_home)
    [ -n "$home" ] || return 0

    local cfg=$home/.config/kwinrc ids id current restored=()
    ids=$(compositor_marker "$cfg")
    [ -n "$ids" ] || return 0

    for id in $ids; do
        # Only what is still the way we left it.
        current=$(plugin_states "$cfg" | awk -v id="$id" '$1 == id { value = $2 } END { print value }')
        if [ "$current" = false ]; then
            as_login_user kwriteconfig6 --file "$cfg" --group Plugins --key "${id}Enabled" true 2>/dev/null \
                && restored+=("$id")
        fi
    done
    as_login_user kwriteconfig6 --file "$cfg" --group "$PROG" --key DisabledEffects --delete 2>/dev/null || true
    [ ${#restored[@]} -eq 0 ] || msg "  login screen compositor: switched back on: ${restored[*]}"
}

cmd_login_compositor() {
    [ "$(id -u)" = 0 ] || [ "$(id -un)" = "$LOGIN_USER" ] \
        || die "this command must be run as root (or as the $LOGIN_USER user)"
    compositor_fix
}

compositor_status() {
    local home
    home=$(login_home)
    [ -n "$home" ] && [ -d "$home" ] || return 0
    if [ ! -x "$home" ] || { [ -e "$home/.config" ] && [ ! -r "$home/.config" ]; }; then
        msg "Login compositor:     (run this command as root to check)"
        return 0
    fi

    local enabled marker
    enabled=$(unwanted_enabled_effects "$home" | paste -sd' ' -)
    marker=$(compositor_marker "$home/.config/kwinrc" | paste -sd' ' -)
    if [ -n "$enabled" ] && [ "$LOGIN_COMPOSITOR_BLUR" = keep ]; then
        msg "Login compositor:     $enabled enabled and left alone (LOGIN_COMPOSITOR_BLUR=keep);"
        msg "                      the blur intensity has no say over what it blurs"
    elif [ -n "$enabled" ]; then
        warn "the compositor effect \"$enabled\" is enabled for the login screen and blurs its whole wallpaper; run \"$PROG sync\" as root"
    elif [ -n "$marker" ]; then
        msg "Login compositor:     switched off for the login screen: $marker"
    else
        msg "Login compositor:     no third-party blur effect enabled"
    fi
}

cmd_sync() {
    need_root
    [ -f "$DATADIR/wrappers/main.qml" ] || die "data files not found in $DATADIR"
    if [ ! -d "$STOCK_ROOT" ]; then
        warn "$STOCK_ROOT does not exist; nothing to do"
        return 0
    fi

    mkdir -p -- "$OVERLAY_ROOT"
    msg "Refreshing wallpaper overlays in $OVERLAY_ROOT"

    local id wanted
    wanted=$(selected_plugins)
    for id in $wanted; do
        build_overlay "$id"
    done

    # Drop overlays of plugins that are no longer selected, and leftovers of
    # interrupted runs.
    local d
    for d in "$OVERLAY_ROOT"/*/ "$OVERLAY_ROOT"/.*."$PROG".*/; do
        [ -d "$d" ] || continue
        d=${d%/}
        id=$(basename "$d")
        case "$id" in
            .*."$PROG".*)
                rm -rf -- "$d"
                continue
                ;;
        esac
        is_ours "$d" || continue
        # shellcheck disable=SC2086
        if ! in_list "$id" $wanted; then
            remove_overlay "$d"
            msg "  $id: no longer selected, overlay removed"
        fi
    done

    compositor_fix
}

cmd_remove() {
    need_root
    compositor_restore
    [ -d "$OVERLAY_ROOT" ] || return 0

    local d
    for d in "$OVERLAY_ROOT"/*/ "$OVERLAY_ROOT"/.*."$PROG".*/; do
        [ -d "$d" ] || continue
        d=${d%/}
        case "$(basename "$d")" in
            .*."$PROG".*)
                rm -rf -- "$d"
                continue
                ;;
        esac
        if is_ours "$d"; then
            remove_overlay "$d"
            msg "  $(basename "$d"): overlay removed"
        fi
    done

    # Tidy up the directories "sync" may have created, if they are empty now.
    rmdir -- "$OVERLAY_ROOT" 2>/dev/null || true
    rmdir -- "$(dirname "$OVERLAY_ROOT")" 2>/dev/null || true
}

# Plasma Login Manager merges its settings from several files. Print the
# effective value of one key: $1 is the fallback, the remaining arguments are
# kreadconfig6's "--group … --key …". Most specific file first.
login_config_read() {
    local fallback=$1
    shift
    local unset_mark=__${PROG}_unset__ file value
    local -a files=("$LOGIN_CONFIG")
    local -a dropins=()
    local i

    dropins=(/usr/lib/plasmalogin/plasmalogin.conf.d/*)
    for ((i = ${#dropins[@]} - 1; i >= 0; i--)); do
        files+=("${dropins[i]}")
    done
    files+=(/usr/lib/plasmalogin/defaults.conf)
    dropins=("$LOGIN_CONFIG".d/*)
    for ((i = ${#dropins[@]} - 1; i >= 0; i--)); do
        files+=("${dropins[i]}")
    done

    for file in "${files[@]}"; do
        [ -f "$file" ] && [ -r "$file" ] || continue
        value=$(kreadconfig6 --file "$file" "$@" --default "$unset_mark" 2>/dev/null) || continue
        if [ "$value" != "$unset_mark" ]; then
            printf '%s\n' "$value"
            return 0
        fi
    done
    printf '%s\n' "$fallback"
}

login_plugin() {
    login_config_read org.kde.image --group Greeter --key WallpaperPluginId
}

# --- the lock screen: per user, in that user's kscreenlockerrc ---

# Whose lock screen: the user running this, or with sudo the user who ran sudo.
lock_user() {
    if [ "$(id -u)" = 0 ] && [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
        printf '%s\n' "$SUDO_USER"
    else
        id -un
    fi
}

# Run a KConfig tool as that user, so that it finds their kscreenlockerrc
# (and the system defaults behind it) and leaves the file owned by them.
lock_tool() {
    local user home
    user=$(lock_user)
    if [ "$user" = "$(id -un)" ]; then
        "$@"
        return
    fi
    home=$(getent passwd "$user" | cut -d: -f6)
    [ -n "$home" ] || die "user $user has no home directory"
    runuser -u "$user" -- env -i HOME="$home" USER="$user" LOGNAME="$user" \
        PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 "$@"
}

# The lock screen's wallpaper type.
lock_plugin() {
    local id
    id=$(lock_tool kreadconfig6 --file kscreenlockerrc --group Greeter --key WallpaperPlugin --default org.kde.image)
    printf '%s\n' "${id:-org.kde.image}"
}

# lock_read <default> <key>
lock_read() {
    lock_tool kreadconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper \
        --group "$(lock_plugin)" --group General --key "$2" --default "$1"
}

# lock_write <key> <value>, or lock_write <key> --delete. Defaults are not
# written but removed, like the Screen Locking settings do.
lock_write() {
    lock_tool kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper \
        --group "$(lock_plugin)" --group General --key "$1" "$2"
}

lock_intensity() {
    local value
    value=$(lock_read 100 "$KEY")
    case "$value" in
        ''|*[!0-9]*) value=100 ;;
    esac
    [ "$value" -le 100 ] || value=100
    printf '%s\n' "$value"
}

lock_style() {
    local value
    value=$(lock_read standard "$STYLE_KEY")
    [ "$value" = frosted ] || value=standard
    printf '%s\n' "$value"
}

lock_overlay_hint() {
    local plugin=$1
    if ! is_ours "$OVERLAY_ROOT/$plugin"; then
        warn "there is no overlay for $plugin, so this setting has no effect yet: add it to PLUGINS in"
        warn "$CONFFILE (or set PLUGINS=all) and run \"sudo $PROG sync\""
    fi
}

cmd_get() {
    command -v kreadconfig6 >/dev/null || die "kreadconfig6 not found"
    if [ "$LOCK" = 1 ]; then
        lock_intensity
        return 0
    fi
    login_config_read 100 --group Greeter --group Wallpaper \
        --group "$(login_plugin)" --group General --key "$KEY"
}

cmd_set() {
    local value=${1:-}
    case "$value" in
        ''|*[!0-9]*) die "set: expected a number from 0 to 100" ;;
    esac
    [ "$value" -le 100 ] || die "set: expected a number from 0 to 100"
    command -v kwriteconfig6 >/dev/null || die "kwriteconfig6 not found"

    local plugin
    if [ "$LOCK" = 1 ]; then
        command -v kreadconfig6 >/dev/null || die "kreadconfig6 not found"
        plugin=$(lock_plugin)
        if [ "$value" = 100 ]; then
            lock_write "$KEY" --delete
        else
            lock_write "$KEY" "$value"
        fi
        msg "Blur intensity for the lock screen wallpaper ($plugin) of $(lock_user) set to $value%."
        msg "It shows the next time the screen is locked."
        lock_overlay_hint "$plugin"
        return 0
    fi
    need_root
    plugin=$(login_plugin)
    kwriteconfig6 --file "$LOGIN_CONFIG" --group Greeter --group Wallpaper \
        --group "$plugin" --group General --key "$KEY" "$value"
    chmod 644 -- "$LOGIN_CONFIG"
    msg "Blur intensity for the login wallpaper ($plugin) set to $value%."
    if ! is_ours "$OVERLAY_ROOT/$plugin"; then
        warn "there is no overlay for $plugin, so this setting has no effect yet (run \"$PROG sync\")"
    fi
}

style_get() {
    local value
    value=$(login_config_read standard --group Greeter --group Wallpaper \
        --group "$(login_plugin)" --group General --key "$STYLE_KEY")
    # Anything but "frosted" is treated as the standard blur, here as on the
    # login screen.
    [ "$value" = frosted ] || value=standard
    printf '%s\n' "$value"
}

cmd_style() {
    local value=${1:-}
    command -v kreadconfig6 >/dev/null || die "kreadconfig6 not found"
    if [ -z "$value" ]; then
        if [ "$LOCK" = 1 ]; then
            lock_style
        else
            style_get
        fi
        return 0
    fi
    case "$value" in
        standard|frosted) ;;
        *) die "style: expected \"standard\" or \"frosted\"" ;;
    esac
    command -v kwriteconfig6 >/dev/null || die "kwriteconfig6 not found"

    local plugin
    if [ "$LOCK" = 1 ]; then
        plugin=$(lock_plugin)
        if [ "$value" = standard ]; then
            lock_write "$STYLE_KEY" --delete
            msg "Blur style for the lock screen wallpaper ($plugin) of $(lock_user) set to standard."
        else
            lock_write "$STYLE_KEY" "$value"
            msg "Blur style for the lock screen wallpaper ($plugin) of $(lock_user) set to frosted glass."
            msg "At the same intensity it is much stronger than the standard blur:"
            msg "25% is about what 100% standard looks like. Intensity now: $(lock_intensity)%."
        fi
        msg "It shows the next time the screen is locked."
        lock_overlay_hint "$plugin"
        return 0
    fi
    need_root
    plugin=$(login_plugin)
    if [ "$value" = standard ]; then
        # The default: leave no entry behind, like the settings page does.
        kwriteconfig6 --file "$LOGIN_CONFIG" --group Greeter --group Wallpaper \
            --group "$plugin" --group General --key "$STYLE_KEY" --delete
    else
        kwriteconfig6 --file "$LOGIN_CONFIG" --group Greeter --group Wallpaper \
            --group "$plugin" --group General --key "$STYLE_KEY" "$value"
    fi
    chmod 644 -- "$LOGIN_CONFIG"
    if [ "$value" = frosted ]; then
        msg "Blur style for the login wallpaper ($plugin) set to frosted glass."
        msg "At the same intensity it is much stronger than the standard blur:"
        msg "25% is about what 100% standard looks like. Intensity now: $(cmd_get)%."
    else
        msg "Blur style for the login wallpaper ($plugin) set to standard."
    fi
    if ! is_ours "$OVERLAY_ROOT/$plugin"; then
        warn "there is no overlay for $plugin, so this setting has no effect yet (run \"$PROG sync\")"
    fi
}

cmd_debug() {
    local mode=${1:-}
    case "$mode" in
        on|off) ;;
        *) die "debug: expected \"on\" or \"off\"" ;;
    esac
    need_root
    command -v kwriteconfig6 >/dev/null || die "kwriteconfig6 not found"

    local plugin
    plugin=$(login_plugin)
    if [ "$mode" = on ]; then
        kwriteconfig6 --file "$LOGIN_CONFIG" --group Greeter --group Wallpaper \
            --group "$plugin" --group General --key LoginBlurDebug --type bool true
        chmod 644 -- "$LOGIN_CONFIG"
        rm -f /tmp/"$PROG"-*.png
        msg "Diagnostics are on. Now:"
        msg "  1. Restart the computer."
        msg "  2. At the login screen, wait 10 seconds, then move the mouse so the"
        msg "     password prompt appears, then leave everything alone for 20 seconds"
        msg "     until the prompt has disappeared again."
        msg "  3. Log in and run: sudo $PROG report"
    else
        kwriteconfig6 --file "$LOGIN_CONFIG" --group Greeter --group Wallpaper \
            --group "$plugin" --group General --key LoginBlurDebug --delete
        chmod 644 -- "$LOGIN_CONFIG"
        rm -f /tmp/"$PROG"-*.png
        msg "Diagnostics are off."
    fi
    if ! is_ours "$OVERLAY_ROOT/$plugin"; then
        warn "there is no overlay for $plugin (run \"$PROG sync\")"
    fi
}

# Print the pixel size of a PNG without needing any image tools.
png_size() {
    local w h
    [ "$(od -A n -t x1 -N 4 -- "$1" 2>/dev/null | tr -d ' \n')" = 89504e47 ] || return 1
    w=$(od -A n -t u1 -j 16 -N 4 -- "$1" | awk '{print (($1 * 256 + $2) * 256 + $3) * 256 + $4}')
    h=$(od -A n -t u1 -j 20 -N 4 -- "$1" | awk '{print (($1 * 256 + $2) * 256 + $3) * 256 + $4}')
    printf '%sx%s' "$w" "$h"
}

describe_image() {
    local f=$1
    if [ ! -e "$f" ]; then
        printf '%s: does not exist\n' "$f"
        return 0
    fi
    ls -ld -- "$f"
    if [ -f "$f" ]; then
        if png_size "$f" >/dev/null 2>&1; then
            printf '  PNG, %s pixels\n' "$(png_size "$f")"
        elif command -v file >/dev/null; then
            printf '  %s\n' "$(file -b -- "$f")"
        fi
    elif [ -d "$f" ]; then
        find "$f" -type f | head -n 20
    fi
}

show_file() {
    local f=$1 limit=${2:-80}
    [ -f "$f" ] || return 0
    printf -- '--- %s\n' "$f"
    head -n "$limit" -- "$f"
    printf '\n'
}

cmd_report() {
    need_root

    # Collect as much as possible: a command that fails or a file that is
    # missing must not stop the report.
    set +e
    set +o pipefail

    local user=${SUDO_USER:-root} userhome dir login_home login_uid
    userhome=$(getent passwd "$user" | cut -d: -f6)
    [ -d "$userhome" ] || userhome=/root
    dir=$userhome/plasma-login-blur-report
    login_home=$(getent passwd plasmalogin | cut -d: -f6)
    login_uid=$(id -u plasmalogin 2>/dev/null || true)

    rm -rf -- "$dir"
    mkdir -p -- "$dir"

    {
        printf '===== %s report, %s =====\n' "$PROG" "$(date)"

        printf '\n===== Versions =====\n'
        uname -r
        if command -v pacman >/dev/null; then
            local pkg
            for pkg in "$PROG" plasma-login-manager plasma-workspace kwin libplasma kirigami \
                qt6-base qt6-declarative qt6-5compat layer-shell-qt; do
                pacman -Q "$pkg" 2>/dev/null
            done
        fi

        printf '\n===== Display manager =====\n'
        local unit
        for unit in plasmalogin sddm; do
            printf '%s: %s\n' "$unit" "$(systemctl is-active "$unit" 2>&1)"
        done

        printf '\n===== Graphics =====\n'
        if command -v lspci >/dev/null; then
            lspci -nnk 2>/dev/null | grep -A 3 -E 'VGA|3D controller|Display controller' | head -n 24
        fi

        printf '\n===== Add-on status =====\n'
        cmd_status 2>&1

        printf '\n===== Login screen configuration =====\n'
        local f
        for f in "$LOGIN_CONFIG" "$LOGIN_CONFIG".d/* /usr/lib/plasmalogin/defaults.conf /usr/lib/plasmalogin/plasmalogin.conf.d/*; do
            show_file "$f" 60
        done

        local luser lhome
        luser=$(lock_user)
        lhome=$(getent passwd "$luser" | cut -d: -f6)
        printf '\n===== Lock screen settings of %s =====\n' "$luser"
        show_file "$lhome/.config/kscreenlockerrc" 60
        show_file /etc/xdg/kscreenlockerrc 40

        printf '\n===== Login wallpaper picture =====\n'
        local image
        image=$(login_config_read "" --group Greeter --group Wallpaper --group "$(login_plugin)" --group General --key Image)
        printf 'configured: %s\n' "${image:-(not set, default picture)}"
        image=${image#file://}
        image=${image%%#*}
        [ -n "$image" ] && describe_image "$image"
        if [ -n "$login_home" ]; then
            ls -la -- "$login_home/wallpapers" 2>&1
        fi

        printf '\n===== Settings of the login screen user (%s) =====\n' "$login_home"
        if [ -n "$login_home" ]; then
            ls -la -- "$login_home" "$login_home/.config" "$login_home/.config/kdedefaults" 2>&1
            for f in kwinrc kdeglobals plasmarc kwinoutputconfig.json kdedefaults/kwinrc kdedefaults/kdeglobals kdedefaults/plasmarc kdedefaults/package; do
                show_file "$login_home/.config/$f" 70
            done
            if [ -d "$login_home/.local/share" ]; then
                printf -- '--- %s/.local/share\n' "$login_home"
                find "$login_home/.local/share" -maxdepth 3 | head -n 40
            fi
        fi

        printf '\n===== Compositor effects for the login screen =====\n'
        printf 'LOGIN_COMPOSITOR_BLUR=%s LOGIN_COMPOSITOR_EFFECTS=%s\n' "$LOGIN_COMPOSITOR_BLUR" "$LOGIN_COMPOSITOR_EFFECTS"
        if [ -n "$login_home" ]; then
            printf 'enabled and unwanted: %s\n' "$(unwanted_enabled_effects "$login_home" | paste -sd' ' -)"
            printf 'switched off by this add-on: %s\n' "$(compositor_marker "$login_home/.config/kwinrc" | paste -sd' ' -)"
        fi
        ls -la /usr/lib/systemd/user/plasma-login-kwin_wayland.service.d 2>&1

        printf '\n===== System-wide KDE defaults =====\n'
        for f in /etc/xdg/kwinrc /etc/xdg/kdeglobals /etc/xdg/plasmarc; do
            show_file "$f" 60
        done

        printf '\n===== KWin effects and scripts installed =====\n'
        ls /usr/lib/qt6/plugins/kwin/effects/plugins /usr/lib/qt6/plugins/kwin/plugins 2>&1
        ls /usr/share/kwin/effects /usr/share/kwin/scripts /usr/share/kwin-wayland/effects /usr/share/kwin-wayland/scripts 2>/dev/null

        printf '\n===== Related packages =====\n'
        if command -v pacman >/dev/null; then
            pacman -Qq | grep -i -E 'blur|kwin|kvantum|wallpaper|plasma-keyboard|plymouth' 
        fi

        printf '\n===== Wallpaper plugins =====\n'
        ls -la -- "$STOCK_ROOT" "$OVERLAY_ROOT" 2>&1

        if command -v journalctl >/dev/null; then
            printf '\n===== Login wallpaper process, this boot =====\n'
            journalctl -b 0 --no-pager -o short-precise 2>/dev/null \
                | grep -E 'plasma-login-wallpaper\[|plasma-login-blur-slider' | grep -v 'Found snapshot' | tail -n 450
            printf '\n===== Login wallpaper process, previous boot =====\n'
            journalctl -b -1 --no-pager -o short-precise 2>/dev/null \
                | grep -E 'plasma-login-wallpaper\[|plasma-login-blur-slider' | grep -v 'Found snapshot' | tail -n 80
            if [ -n "$login_uid" ]; then
                printf '\n===== Login screen session, warnings this boot =====\n'
                journalctl -b 0 --no-pager -o short-precise -p warning _UID="$login_uid" 2>/dev/null | tail -n 60
            fi
        fi

        printf '\n===== Screenshots saved by the wallpaper process =====\n'
        local shot found=0
        for shot in /tmp/"$PROG"-*.png; do
            [ -f "$shot" ] || continue
            found=1
            describe_image "$shot"
            cp -- "$shot" "$dir/" 2>&1
        done
        [ "$found" = 1 ] || printf 'none (diagnostics not on, or the login screen has not been started since)\n'
    } > "$dir/report.txt" 2>&1

    chown -R -- "$user": "$dir" 2>/dev/null || true
    msg "Report written to $dir"
    msg "  report.txt        text report"
    ls -- "$dir" | grep -v '^report.txt$' | sed 's/^/  /'
}

cmd_status() {
    msg "$PROG $VERSION"
    msg "Stock plugins: $STOCK_ROOT"
    msg "Overlays:      $OVERLAY_ROOT"

    local id state
    for id in $(selected_plugins); do
        if is_ours "$OVERLAY_ROOT/$id"; then
            state="overlay active"
            [ -f "$STOCK_ROOT/$id/contents/ui/main.qml" ] || state="overlay BROKEN (stock plugin missing; run \"$PROG sync\")"
        elif [ -e "$OVERLAY_ROOT/$id" ]; then
            state="not managed (a different override exists in $OVERLAY_ROOT)"
        elif [ -f "$STOCK_ROOT/$id/contents/ui/main.qml" ]; then
            state="no overlay (run \"$PROG sync\")"
        else
            state="not installed"
        fi
        msg "  $(printf '%-32s' "$id") $state"
    done

    if command -v kreadconfig6 >/dev/null; then
        msg "Login wallpaper type: $(login_plugin)"
        msg "Blur intensity:       $(LOCK=0 cmd_get)%"
        if [ "$(style_get)" = frosted ]; then
            msg "Blur style:           frosted glass"
        else
            msg "Blur style:           standard"
        fi
        # The lock screen is per user; as plain root there is no user to show.
        local luser
        luser=$(lock_user)
        if [ "$luser" != root ]; then
            local lplugin lstyle=standard
            lplugin=$(lock_plugin)
            [ "$(lock_style)" = frosted ] && lstyle="frosted glass"
            msg "Lock screen ($luser): $lplugin, blur intensity $(lock_intensity)%, style $lstyle"
            if ! is_ours "$OVERLAY_ROOT/$lplugin"; then
                msg "                      (no overlay for $lplugin: its blur is not affected)"
            fi
        fi
    fi
    compositor_status

    # Plugins are looked up along XDG_DATA_DIRS; the overlay has to come first.
    local overlay_base=${OVERLAY_ROOT%/plasma/wallpapers}
    local stock_base=${STOCK_ROOT%/plasma/wallpapers}
    local dirs=${XDG_DATA_DIRS:-/usr/local/share:/usr/share}
    local dir overlay_pos=0 stock_pos=0 n=0
    local IFS=:
    for dir in $dirs; do
        n=$((n + 1))
        dir=${dir%/}
        [ "$dir" = "$overlay_base" ] && [ "$overlay_pos" = 0 ] && overlay_pos=$n
        [ "$dir" = "$stock_base" ] && [ "$stock_pos" = 0 ] && stock_pos=$n
    done
    unset IFS
    if [ "$overlay_pos" = 0 ]; then
        warn "$overlay_base is not in this session's XDG_DATA_DIRS; the overlays will not be found"
    elif [ "$stock_pos" != 0 ] && [ "$overlay_pos" -gt "$stock_pos" ]; then
        warn "$overlay_base comes after $stock_base in this session's XDG_DATA_DIRS; the overlays will not be used"
    else
        msg "Search order:         OK ($overlay_base is searched before $stock_base in this session)"
    fi
}

main() {
    local cmd="" args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -q|--quiet) QUIET=1 ;;
            --lock) LOCK=1 ;;
            -h|--help) usage; exit 0 ;;
            -V|--version) printf '%s %s\n' "$PROG" "$VERSION"; exit 0 ;;
            -*) die "unknown option: $1 (see --help)" ;;
            *)
                if [ -z "$cmd" ]; then
                    cmd=$1
                else
                    args+=("$1")
                fi
                ;;
        esac
        shift
    done

    load_conf

    case "$cmd" in
        sync) cmd_sync ;;
        remove) cmd_remove ;;
        status) cmd_status ;;
        get) cmd_get ;;
        set) cmd_set "${args[0]:-}" ;;
        style) cmd_style "${args[0]:-}" ;;
        login-compositor) cmd_login_compositor ;;
        debug) cmd_debug "${args[0]:-}" ;;
        report) cmd_report ;;
        '') usage; exit 1 ;;
        *) die "unknown command: $cmd (see --help)" ;;
    esac
}

main "$@"
